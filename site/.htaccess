DirectoryIndex index.html
Options -Indexes
# HTTPS only (free Let's Encrypt certificate, turned on in konsoleH SSL Manager 2026-11-23)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
<FilesMatch "\.(csv|txt|log)$">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>
